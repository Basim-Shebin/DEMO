# Function to create PDF
def create_pdf(filename):
    c = canvas.Canvas(filename, pagesize=A4)
    width, height = A4
    
    c.setFont("Helvetica-Bold", 14)
    c.drawCentredString(width / 2, height - 50, college_name)
    
    c.setFont("Helvetica", 12)
    c.drawString(50, height - 80, f"SEMESTER: {semester}")
    c.drawString(300, height - 80, f"DATE: {date}")
    c.drawString(50, height - 100, f"SCHEME: {scheme}")
    c.drawString(300, height - 100, f"TIME: {time}")
    c.drawString(50, height - 120, f"FORMAT No: {format_no}")

    y_position = height - 160

    # Table Headers
    c.setFont("Helvetica-Bold", 10)
    headers = ["SI No", "Seat No", "Register No - Name", "P/A", "Hall"]
    col_widths = [40, 60, 250, 40, 100]
    x_positions = [50, 90, 150, 400, 450]

    for i, header in enumerate(headers):
        c.drawString(x_positions[i], y_position, header)
    
    y_position -= 20
    c.line(50, y_position + 10, 550, y_position + 10)  # Header Line

    # Subject-wise student listing
    c.setFont("Helvetica", 10)
    si_no = 1
    for subject, students, hall in subjects:
        c.setFont("Helvetica-Bold", 10)
        c.drawString(50, y_position, subject)
        y_position -= 15
        c.setFont("Helvetica", 10)
        
        for seat_no, reg_name, status in students:
            c.drawString(x_positions[0], y_position, str(si_no))
            c.drawString(x_positions[1], y_position, seat_no)
            c.drawString(x_positions[2], y_position, reg_name)
            c.drawString(x_positions[3], y_position, status)
            c.drawString(x_positions[4], y_position, hall)
            y_position -= 15
            si_no += 1
        
        y_position -= 10

    # Absentees Section
    c.setFont("Helvetica-Bold", 10)
    c.drawString(50, y_position, "ABSENTEES STATEMENT")
    y_position -= 15
    c.line(50, y_position + 10, 550, y_position + 10)

    c.setFont("Helvetica", 10)
    for subject, absent_list in absentees.items():
        c.drawString(50, y_position, f"SUBJECT CODE: {subject}")
        c.drawString(150, y_position, f"REGISTER NUMBER OF ABSENTEES: {', '.join(absent_list)}")
        y_position -= 15

    # Signature Section
    c.setFont("Helvetica", 10)
    c.drawString(50, y_position - 20, "Signature of Invigilator:")
    
    # Save PDF
    c.save()

# Generate PDF
create_pdf("Seating_Layout.pdf")
