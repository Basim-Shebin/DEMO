5. select book_issues.bookid,Students.name,books.title,librarians.name from book_issues natural join books natural join Students  join librarians on librarians.librarianid=book_issues.librarianid;


6. select librarians.librarianid,librarians.name,count(book_issues.bookid) as NO_OF_BOOKS from book_issues join librarians on librarians.librarianid=book_issues.librarianid group by librarians.librarianid,librarians.name;


7. select librarians.librarianid,librarians.name from librarians left join book_issues on librarians.librarianid=book_issues.librarianid group by librarians.librarianid having count(bookid)=0;
